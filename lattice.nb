   "ObjectType" -> "Symbol", "Usage" -> 
    "GluedTransitionMatrix[sites] glues two copies of the region along its \
cut edges: every edge that leaves copy 1 lands on the twin site in copy 2, \
and vice versa. Indices 1..n are copy 1, n+1..2n are copy 2. For a disk this \
is the lattice sphere <psi_0|psi_0>. The surface is closed, so P has an \
eigenvalue exactly 1.", "Documentation" -> None, "OwnValues" -> None, 
    "UpValues" -> None, "DownValues" -> 
    Information`InformationValueForm[
     DownValues, LatticeLoops`GluedTransitionMatrix, {
      LatticeLoops`GluedTransitionMatrix[
         Pattern[LatticeLoops`Private`sites, 
          Blank[List]]] :> 
       Module[{LatticeLoops`Private`n = Length[LatticeLoops`Private`sites], 
          LatticeLoops`Private`idx, LatticeLoops`Private`pos}, 
         LatticeLoops`Private`idx = 
          AssociationThread[
           LatticeLoops`Private`sites -> Range[LatticeLoops`Private`n]]; 
         LatticeLoops`Private`pos = Flatten[
            Table[
             With[{LatticeLoops`Private`j = Lookup[LatticeLoops`Private`idx, 
                 Key[
                 Part[LatticeLoops`Private`sites, LatticeLoops`Private`i] + 
                  LatticeLoops`Private`d], 0]}, 
              If[
              LatticeLoops`Private`j == 
               0, {{LatticeLoops`Private`i, LatticeLoops`Private`i + 
                 LatticeLoops`Private`n}, {
                LatticeLoops`Private`i + LatticeLoops`Private`n, 
                 LatticeLoops`Private`i}}, {{
                LatticeLoops`Private`i, LatticeLoops`Private`j}, {
                LatticeLoops`Private`i + LatticeLoops`Private`n, 
                 LatticeLoops`Private`j + LatticeLoops`Private`n}}]], {
             LatticeLoops`Private`i, LatticeLoops`Private`n}, {
             LatticeLoops`Private`d, LatticeLoops`Private`$nbrs}], 2]; 
         SparseArray[
           KeyValueMap[# -> #2/4& , 
            Counts[LatticeLoops`Private`pos]], {
           2 LatticeLoops`Private`n, 2 LatticeLoops`Private`n}]]}], 
    "SubValues" -> None, "DefaultValues" -> None, "NValues" -> None, 
    "FormatValues" -> None, "Options" -> None, "Attributes" -> {}, "FullName" -> 
