Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"-", 
      RowBox[{"Log", "[", 
       RowBox[{"Det", "[", 
        RowBox[{"1", "-", "P_D"}], "]"}], "]"}]}], " ", "for", " ", "D"}], "=", 
    RowBox[{
     RowBox[{"DiskSites", "[", "R", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"integer", " ", "R"}], ",", 
       RowBox[{"centered", " ", "at", " ", "the", " ", "origin"}]}], 
      ")"}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"diskLoopMass", "[", "R_Integer", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ws", ",", 
        RowBox[{"logdet", "=", "0."}], ",", "Sinv", ",", 
        RowBox[{"wP", "=", 
         RowBox[{"-", "1"}]}], ",", "n", ",", "S", ",", "m"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"half", "-", 
        RowBox[{"width", " ", "of", " ", "each", " ", "row", " ", 
         RowBox[{"y", ":", 
          RowBox[{
           RowBox[{
            RowBox[{"largest", " ", "x", " ", "with", " ", 
             RowBox[{"x", "^", "2"}]}], "+", 
            RowBox[{"y", "^", "2"}]}], "<", 
           RowBox[{"R", "^", "2"}]}]}]}]}], "*)"}], 
      RowBox[{
       RowBox[{"ws", "=", 
        RowBox[{"Floor", "[", 
         RowBox[{"Sqrt", "[", 
          RowBox[{
           RowBox[{"R", "^", "2"}], "-", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{
              RowBox[{"-", 
               RowBox[{"(", 
                RowBox[{"R", "-", "1"}], ")"}]}], ",", 
              RowBox[{"R", "-", "1"}]}], "]"}], "^", "2"}], "-", "1"}], "]"}],
          "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"n", "=", 
           RowBox[{
            RowBox[{"2", " ", "w"}], "+", "1"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"S", "=", 
           RowBox[{"Normal", "[", 
            RowBox[{"SparseArray", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{
                 RowBox[{"Band", "[", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "1"}], "}"}], "]"}], "->", "1."}], ",", 
                RowBox[{
                 RowBox[{"Band", "[", 
                  RowBox[{"{", 
                   RowBox[{"1", ",", "2"}], "}"}], "]"}], "->", 
                 RowBox[{"-", "0.25"}]}], ",", 
                RowBox[{
                 RowBox[{"Band", "[", 
                  RowBox[{"{", 
                   RowBox[{"2", ",", "1"}], "}"}], "]"}], "->", 
                 RowBox[{"-", "0.25"}]}]}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"n", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"wP", ">=", "0"}], ",", 
            RowBox[{"(*", 
             RowBox[{"integrate", " ", "out", " ", "the", " ", "previous", " ", 
              RowBox[{"rows", ":", 
               RowBox[{
               "couple", " ", "vertically", " ", "adjacent", " ", 
                "sites"}]}]}], "*)"}], 
            RowBox[{
             RowBox[{"m", "=", 
              RowBox[{"Min", "[", 
               RowBox[{"w", ",", "wP"}], "]"}]}], ";", "\[IndentingNewLine]", 
             
             RowBox[{
              RowBox[{"S", "[", 
               RowBox[{"[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"w", "-", "m", "+", "1"}], ";;", 
                  RowBox[{"w", "+", "m", "+", "1"}]}], ",", 
                 RowBox[{
                  RowBox[{"w", "-", "m", "+", "1"}], ";;", 
                  RowBox[{"w", "+", "m", "+", "1"}]}]}], "]"}], "]"}], "-=", 
              RowBox[{
               RowBox[{"Sinv", "[", 
                RowBox[{"[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"wP", "-", "m", "+", "1"}], ";;", 
                   RowBox[{"wP", "+", "m", "+", "1"}]}], ",", 
                  RowBox[{
                   RowBox[{"wP", "-", "m", "+", "1"}], ";;", 
                   RowBox[{"wP", "+", "m", "+", "1"}]}]}], "]"}], "]"}], "/", 
               "16"}]}]}]}], "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"logdet", "+=", 
           RowBox[{"Log", "[", 
            RowBox[{"Det", "[", "S", "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Sinv", "=", 
           RowBox[{"Inverse", "[", "S", "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"wP", "=", "w"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"w", ",", "ws"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"-", "logdet"}]}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"masses", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"diskLoopMass", "[", "R", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"R", ",", "2", ",", "50"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"ListPlot", "[", 
    RowBox[{"Log", "[", "masses", "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.002644395369278*^9, 4.002644395369316*^9}, {
  4.002651030840968*^9, 4.002651062715008*^9}},
 CellLabel->"In[43]:=",ExpressionUUID->"b2f445be-e214-41b7-b270-08d12c2ff106"],

